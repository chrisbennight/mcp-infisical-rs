# Gateway-profile example. For stdio or standalone HTTP see docs/standalone.md;
# do not supply gateway identity settings to those modes.
# Listener configuration. The service is intended to be reachable only from
# an isolated network behind a trusted gateway.
INFISICAL_MCP_HOST=0.0.0.0
INFISICAL_MCP_PORT=8000
INFISICAL_MCP_LOG_LEVEL=info
# Static capabilities, separate from HTTP authentication: metadata, secrets, pkiSsh, full.
INFISICAL_MCP_OPERATION_PROFILE=full
INFISICAL_MCP_ALLOWED_HOSTS=infisical-mcp,infisical-mcp:8000
INFISICAL_MCP_ALLOWED_ORIGINS=
INFISICAL_MCP_REQUEST_TIMEOUT_SECONDS=30
INFISICAL_MCP_MAX_CONCURRENT_REQUESTS=32
INFISICAL_MCP_MAX_BODY_BYTES=1048576

# Self-hosted Infisical API and a dedicated Machine Identity. Do not reuse a
# host-wide identity or put real credentials in this file.
INFISICAL_API_URL=https://infisical.example.com
# Keep false unless the API URL is an isolated private-network authority. A
# service name must resolve exclusively to RFC 1918 or IPv6 unique-local IPs.
INFISICAL_API_ALLOW_PRIVATE_HTTP=false
# Shared upstream HTTP request budget for all calls, including KMS preflights.
INFISICAL_API_MAX_CONCURRENT_REQUESTS=32
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# Optional when the Machine Identity client ID needs an organization scope.
INFISICAL_UNIVERSAL_AUTH_ORGANIZATION_SLUG=

# Gateway-to-server service authentication. During rotation, the server may
# accept both values; the gateway sends only the current value.
INFISICAL_MCP_BEARER_CURRENT=
INFISICAL_MCP_BEARER_PREVIOUS=

# Optional reveal transfer plane. When set to the origin the gateway dials
# (same scheme and authority as /mcp), reveal-class operations return
# out-of-context file references instead of inline secret values. Leave unset
# unless the gateway's file storage is enabled.
#INFISICAL_MCP_FILE_PUBLIC_URL=http://infisical-mcp:8000
#INFISICAL_MCP_FILE_TTL_SECONDS=120
#INFISICAL_MCP_FILE_MAX_STAGED=16
# Aggregate reserved and retained transfer bytes (default 512 MiB).
#INFISICAL_MCP_FILE_MAX_STAGED_BYTES=536870912

# Signed caller identity minted by the MCP tool-search gateway.
INFISICAL_MCP_IDENTITY_ISSUER=https://gateway.example.com
INFISICAL_MCP_IDENTITY_JWKS_URL=https://gateway.example.com/.well-known/jwks.json
# Keep false unless the JWKS URL is an isolated private-network authority. A
# service name must resolve exclusively to RFC 1918 or IPv6 unique-local IPs.
INFISICAL_MCP_IDENTITY_ALLOW_PRIVATE_HTTP=false
